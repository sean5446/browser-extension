{
    "manifest_version": 3,
    "name": "Link Notepad",
    "version": "1.0.0",
    "description": "A notepad for links. Highlight some and open them all in new tabs.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Link Notepad"
    },
    "permissions": [
        "storage",
        "activeTab"
    ]
}
